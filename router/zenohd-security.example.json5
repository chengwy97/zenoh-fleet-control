{
  mode: "router",
  listen: { endpoints: { router: ["tls/0.0.0.0:7447"] } },
  transport: {
    tls: {
      enable_mtls: true,
      listen_certificate: "/etc/zenoh/router-cert.pem",
      listen_private_key: "/etc/zenoh/router-key.pem",
      root_ca_certificate: "/etc/zenoh/ca.pem",
      verify_name_on_connect: true
    },
    auth: {
      usrpwd: { dictionary_file: "/etc/zenoh/users.passwd" }
    }
  },
  access_control: {
    enabled: true,
    default_permission: "deny"
  }
}
